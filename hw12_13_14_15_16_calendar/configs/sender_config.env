# Application
ENVIRONMENT=local
LOG_LEVEL=debug

# Sender
SENDER_PREFETCH=10

# RabbitMQ
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=rabbit
RABBIT_PASSWORD=password
RABBIT_VHOST=/
RABBIT_EXCHANGE=calendar
RABBIT_QUEUE=calendar.notifications
RABBIT_ROUTING_KEY=notification

# Database
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=backend
DB_SSL=disable
