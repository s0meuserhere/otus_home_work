# Application
ENVIRONMENT=local
LOG_LEVEL=debug
# Планировщик работает только с БД, поэтому нужен STORAGE_MODE=1. При 0 процесс завершится с ошибкой.
STORAGE_MODE=1

# Scheduler
SCHEDULER_INTERVAL=1m
SCHEDULER_RETENTION=8760h
SCHEDULER_RUN_TIMEOUT=5s

# Database
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=backend
DB_SSL=disable

# RabbitMQ
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=rabbit
RABBIT_PASSWORD=password
RABBIT_VHOST=/
RABBIT_EXCHANGE=calendar
RABBIT_QUEUE=calendar.notifications
RABBIT_ROUTING_KEY=notification
